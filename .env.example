# Example environment file for AI-ITSS (Customer-Support-Agent).
#
# Copy this to `.env` (which is git-ignored) and fill in real values for
# local development. `config/settings.yaml` holds non-secret configuration;
# secrets and environment-specific values belong here instead.
#
# This file documents every environment variable currently referenced in the
# codebase. Other Phase 2 work may add more (e.g. OAuth2/Jira/LLM vars) as
# those integrations land — add them here as they appear in the code.

# Zoho CRM integration (backend/integrations/zoho_sync.py)
# Optional: base URL for the Zoho API. Defaults to https://www.zohoapis.com
# if unset, so this only needs to be set for a non-default Zoho region/instance.
ZOHO_API_BASE=https://www.zohoapis.com

# Required for any real (non-mock) Zoho sync calls: Zoho OAuth bearer token.
# If unset, ZohoSync logs a warning and runs in mock mode (returns empty
# results / no-ops instead of calling the Zoho API).
ZOHO_API_TOKEN=
